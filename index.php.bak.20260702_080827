$delivered_month_freight = $db->query("SELECT COALESCE(SUM(freight_amount),0) f FROM despatch_orders WHERE status='Delivered' AND total_weight > 0 AND MONTH(despatch_date)=MONTH(CURDATE()) AND YEAR(despatch_date)=YEAR(CURDATE())" . $_dash_desp_filter)->fetch_assoc()['f'] ?? 0;
